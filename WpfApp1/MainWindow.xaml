                        <Button Grid.Column="10" x:Name="BtnDisaggregateStorage" Style="{StaticResource SlateOutlineBtn}" Click="BtnDisaggregateStorage_Click" ToolTip="Disaggregate multiple VHDXs across separate CSV storage volumes">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾 Multi-Disk" Foreground="{StaticResource BrushTextWhite}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="12" x:Name="BtnScheduleBatch" Style="{StaticResource SlateOutlineBtn}" Click="BtnScheduleBatch_Click" ToolTip="Schedule unattended batch live migration with concurrency control">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱ Schedule" Foreground="{StaticResource BrushSuccess}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="14" x:Name="BtnExecuteMigration" Style="{StaticResource CyanActionBtn}" Click="BtnExecuteMigration_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoLightning}" Fill="{StaticResource BrushTextWhite}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Execute Live Migration"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

            </Grid>

            <!-- ===================================================== -->
            <!-- 2. GLOBAL INVENTORY VIEW                              -->
            <!-- ===================================================== -->
            <Grid Visibility="{Binding ElementName=NavInventory, Path=IsChecked, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoInventory}" Fill="{StaticResource BrushCyanAccentHover}" Stretch="Uniform" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Global Virtual Machine Inventory" Foreground="{StaticResource BrushTextWhite}" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Text="Aggregate view of all workloads across configured Hyper-V hosts with bulk action control." Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="34,4,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource BrushCardGradient}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Managed Hosts" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                            <TextBox Grid.Row="1" x:Name="TxtNewHostName" Text="192.168.25.29" Tag="IP / FQDN (e.g. dc1.domain.local)" Style="{StaticResource EnterpriseInputTextBox}" Margin="0,0,0,8"/>

                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtNewHostUser" Tag="Domain\User" Style="{StaticResource EnterpriseInputTextBox}"/>
                                <PasswordBox Grid.Column="2" x:Name="TxtNewHostPass" Tag="Password" Style="{StaticResource EnterpriseInputPasswordBox}" PasswordChanged="PasswordBox_PasswordChanged"/>
                            </Grid>

                            <Button Grid.Row="3" Content="+ Add / Sync Host" Style="{StaticResource CyanActionBtn}" Click="BtnAddHost_Click" Margin="0,0,0,16"/>

                            <ListBox Grid.Row="4" x:Name="ManagedHostsListBox" Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" Foreground="{StaticResource BrushTextWhite}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0D1D30" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{StaticResource BrushSuccess}" VerticalAlignment="Center" Margin="0,0,10,0" Effect="{StaticResource EffectGreenGlow}"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Hostname}" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="Agentless WinRM Ready" Foreground="{StaticResource BrushTextSecondary}" FontSize="10"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="✕" Style="{StaticResource PowerOpBtn}" Tag="{Binding}" Click="BtnRemoveHost_Click" Width="24" Height="24" Padding="0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource BrushCardGradient}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Aggregated Workloads" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>

                                <!-- BULK MULTI-VM ACTIONS TOOLBAR -->
                                <Border Grid.Column="2" x:Name="BulkActionBar" Visibility="Collapsed" Background="#0C1F33" BorderBrush="{StaticResource BrushCyanAccentHover}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtBulkSelectionCount" Text="0 Selected" Foreground="{StaticResource BrushCyanAccentHover}" FontWeight="Bold" FontSize="11" Margin="4,0,10,0" VerticalAlignment="Center"/>
                                        <Button Content="▶ Start" Style="{StaticResource PowerOpBtn}" Click="BtnBulkStartVm_Click" ToolTip="Start all selected workloads"/>
                                        <Button Content="⏹ Stop" Style="{StaticResource PowerOpBtn}" Click="BtnBulkStopVm_Click" ToolTip="Force stop all selected workloads"/>
                                        <Button Content="🔄 Restart" Style="{StaticResource PowerOpBtn}" Click="BtnBulkRestartVm_Click" ToolTip="Restart all selected workloads"/>
                                        <Button Content="📸 Snap" Style="{StaticResource PowerOpBtn}" Click="BtnBulkCheckpointVm_Click" ToolTip="Create point-in-time snapshots on all selected workloads"/>
                                    </StackPanel>
                                </Border>

                                <TextBox Grid.Column="4" x:Name="TxtSearchVms" Tag="Search VMs..." Style="{StaticResource EnterpriseInputTextBox}" TextChanged="TxtSearchVms_TextChanged"/>

                                <Button Grid.Column="6" x:Name="BtnRefreshAll" Content="Refresh All" Style="{StaticResource SlateOutlineBtn}" Click="BtnRefreshAll_Click"/>
                            </Grid>

                            <Border Grid.Row="1" Background="#060C14" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                <ListView x:Name="AggregatedWorkloadsList" SelectionMode="Extended" SelectionChanged="AggregatedWorkloadsList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextWhite}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="VIRTUAL MACHINE" Width="210">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="4,2">
                                                            <Path Data="{StaticResource GeoServerStack}" Fill="{StaticResource BrushCyanAccentHover}" Stretch="Uniform" Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="STATUS" Width="105">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#0D253A" BorderBrush="{StaticResource BrushCyanAccent}" BorderThickness="1" CornerRadius="5" Padding="7,3" Margin="0,2">
                                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource BrushCyanAccentHover}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="MEMORY" Width="115">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Foreground="{StaticResource BrushTextSecondary}" Margin="4,2" VerticalAlignment="Center">
                                                            <Run Text="{Binding MemoryMB}" Foreground="{StaticResource BrushTextWhite}" FontWeight="SemiBold"/><Run Text=" MB"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="RESIDENT HOST" Width="150">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ResidentHost}" Foreground="{StaticResource BrushTextWhite}" Margin="4,2" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <!-- POWER, CHECKPOINT & HARDWARE TUNING OPERATIONS -->
                                            <GridViewColumn Header="OPERATIONS &amp; TUNING" Width="360">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                                            <Button Content="▶ Start" Style="{StaticResource PowerOpBtn}" Tag="{Binding}" Click="BtnStartVm_Click"/>
                                                            <Button Content="⏹ Stop" Style="{StaticResource PowerOpBtn}" Tag="{Binding}" Click="BtnStopVm_Click"/>
                                                            <Button Content="🔄 Restart" Style="{StaticResource PowerOpBtn}" Tag="{Binding}" Click="BtnRestartVm_Click"/>
                                                            <Button Content="📸 Snap" Style="{StaticResource PowerOpBtn}" Tag="{Binding}" Click="BtnCreateVmCheckpoint_Click" ToolTip="Create instant recovery snapshot"/>
                                                            <Button Content="🔍 Snaps" Style="{StaticResource PowerOpBtn}" Tag="{Binding}" Click="BtnManageVmCheckpoints_Click" ToolTip="Inspect and manage AVHDX delta chains"/>
                                                            <Button Content="⚙ Edit Specs" Style="{StaticResource PowerOpBtn}" Tag="{Binding}" Click="BtnEditInventoryVmSpecs_Click"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===================================================== -->
            <!-- 3. ACTIVE JOBS VIEW                                   -->
            <!-- ===================================================== -->
            <Grid Visibility="{Binding ElementName=NavJobs, Path=IsChecked, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoPulse}" Fill="{StaticResource BrushCyanAccentHover}" Stretch="Uniform" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Active Jobs &amp; History" Foreground="{StaticResource BrushTextWhite}" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Text="Monitor running migrations and view logs from previous executions." Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="34,4,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Jobs List -->
                    <Border Grid.Column="0" Background="{StaticResource BrushCardGradient}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Session Migration Tasks" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                            <ListBox Grid.Row="1" x:Name="JobsListBox" Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" SelectionChanged="JobsListBox_SelectionChanged" Foreground="{StaticResource BrushTextWhite}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0D1D30" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,4">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <TextBlock Text="{Binding VmName}" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="13"/>
                                                    <Border HorizontalAlignment="Right" Background="#0D253A" BorderBrush="{StaticResource BrushCyanAccent}" BorderThickness="1" CornerRadius="5" Padding="7,2">
                                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource BrushCyanAccentHover}" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,4,0,0">
                                                    <Run Text="{Binding SourceHost, Mode=OneWay}"/><Run Text=" ➔ "/><Run Text="{Binding TargetHost, Mode=OneWay}"/>
                                                    <Run Text=" | "/><Run Text="{Binding DurationText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Right: Execution Log Terminal & Compliance Toolbar -->
                    <Border Grid.Column="2" Background="{StaticResource BrushCardGradient}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <TextBlock Text="Live Execution Terminal &amp; Audit Trail" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Clear History" Style="{StaticResource SlateOutlineBtn}" Click="BtnClearJobs_Click" Margin="0,0,8,0" Padding="10,6" FontSize="11"/>
                                    <Button Content="Export HTML Audit Report" Style="{StaticResource CyanActionBtn}" Click="BtnExportAuditReport_Click" Padding="14,6" FontSize="11"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Background="#04070C" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <TextBox x:Name="TxtTerminalLogs" Background="Transparent" Foreground="{StaticResource BrushCyanAccentHover}" FontFamily="Consolas" FontSize="12" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="Select a job on the left to inspect its live streaming telemetry logs."/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===================================================== -->
            <!-- 4. PLATFORM SETTINGS VIEW                             -->
            <!-- ===================================================== -->
            <Grid Visibility="{Binding ElementName=NavSettings, Path=IsChecked, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoSettings}" Fill="{StaticResource BrushCyanAccentHover}" Stretch="Uniform" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Platform Settings" Foreground="{StaticResource BrushTextWhite}" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Text="Configure global defaults, dedicated migration subnets, transport QoS, and security delegation." Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="34,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="{StaticResource BrushCardGradient}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="1" CornerRadius="12" Padding="24" VerticalAlignment="Top">
                    <StackPanel>
                        <!-- Storage Settings -->
                        <TextBlock Text="DEFAULT STORAGE PATHS" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        <TextBlock Text="Default Cluster Storage Destination" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtDefaultStoragePath" Text="C:\ClusterStorage\Volume1" Tag="Storage Destination Path" Style="{StaticResource EnterpriseInputTextBox}" Margin="0,0,0,6"/>
                        <TextBlock Text="Injected into Move-VM -DestinationStoragePath parameter." Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,16"/>

                        <!-- Live Migration Transport & QoS Settings -->
                        <TextBlock Text="LIVE MIGRATION TRANSPORT &amp; QoS" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PERFORMANCE OPTION" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbMigrationPerformance" Style="{StaticResource HighContrastStorageComboBox}">
                                    <ComboBoxItem Content="Compression" IsSelected="True"/>
                                    <ComboBoxItem Content="SMB"/>
                                    <ComboBoxItem Content="TCP"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MAX BANDWIDTH LIMIT (MBPS)" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtMigrationBandwidthLimit" Text="0" Style="{StaticResource EnterpriseInputTextBox}" Margin="0,2,0,0"/>
                                <TextBlock Text="0 = Unlimited bandwidth consumption." Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- DEDICATED LIVE MIGRATION SUBNET SELECTOR -->
                        <TextBlock Text="DEDICATED LIVE MIGRATION NETWORKS (SUBNET ISOLATION)" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        <TextBlock Text="Isolate live migration traffic to high-speed 10GbE/25GbE interfaces to prevent saturated client gaming links." Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ListBox Grid.Column="0" x:Name="MigrationSubnetsListBox" Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" MaxHeight="130" Foreground="{StaticResource BrushTextWhite}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="10,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SubnetOrIp}" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Text="{Binding InterfaceAlias}" Foreground="{StaticResource BrushTextMuted}" FontSize="10"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Foreground="{StaticResource BrushCyanAccentHover}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                    <Run Text="Priority: "/><Run Text="{Binding Priority}"/>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                <Button x:Name="BtnDetectMigrationSubnets" Content="Detect Host Subnets" Style="{StaticResource SlateOutlineBtn}" Click="BtnDetectMigrationSubnets_Click" Width="170" Margin="0,0,0,8"/>
                                <Button x:Name="BtnSaveMigrationSubnets" Content="Apply Subnets to Host" Style="{StaticResource CyanActionBtn}" Click="BtnSaveMigrationSubnets_Click" Width="170"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{StaticResource BrushCardBorder}" Margin="0,0,0,16"/>

                        <!-- Security Delegation -->
                        <TextBlock Text="SECURITY &amp; DELEGATION" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                        <Border Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                            <CheckBox x:Name="ChkCredSsp" IsChecked="True">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Enable CredSSP Delegation" Foreground="{StaticResource BrushTextWhite}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Required when migrating workloads between remote Hyper-V hosts from an external admin workstation." Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <Separator Background="{StaticResource BrushCardBorder}" Margin="0,0,0,16"/>

                        <!-- ABOUT & AUTHOR CREDITS CARD -->
                        <TextBlock Text="ABOUT &amp; CREDITS" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                        <Border Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource BrushCyanBtnGradient}" CornerRadius="10" Width="48" Height="48" Margin="0,0,16,0" Effect="{StaticResource EffectCyanGlow}">
                                    <Path Data="{StaticResource GeoServerStack}" Fill="{StaticResource BrushTextWhite}" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="WinMigrate Pro (ElectroMU Edition)" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="14.5"/>
                                    <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,2,0,0">
                                        <Run Text="Lead Architect: "/><Run Text="Oleg Melnikov" Foreground="{StaticResource BrushCyanAccentHover}" FontWeight="Bold"/>
                                        <Run Text=" &#x2022; "/><Run Text="ElectroMU Gaming Network" Foreground="{StaticResource BrushSuccess}" FontWeight="Bold"/>
                                    </TextBlock>
                                    <TextBlock Text="Centralized, agentless Hyper-V live migration console. Distributed as open-source under the GNU GPLv3 License." Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Button x:Name="BtnSaveSettings" Content="Save Configuration" Style="{StaticResource CyanActionBtn}" Click="BtnSaveSettings_Click" HorizontalAlignment="Right" Width="160"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================================================== -->
            <!-- 5. vCENTER TO HYPER-V V2V IMPORTER VIEW               -->
            <!-- ===================================================== -->
            <Grid Visibility="{Binding ElementName=NavVCenter, Path=IsChecked, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoServerContainer}" Fill="{StaticResource BrushCyanAccentHover}" Stretch="Uniform" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="vCenter to Hyper-V V2V Importer" Foreground="{StaticResource BrushTextWhite}" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Text="Cold disk conversion (VMDK ➔ VHDX) with automatic BIOS/EFI firmware parity and Hyper-V provisioning." Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="34,4,0,0"/>
                </StackPanel>

                <!-- Main Conversion Cockpit Grid -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT CARD: VMWARE VCENTER SOURCE -->
                    <Border Grid.Column="0" Background="{StaticResource BrushCardGradient}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="VMware vCenter / ESXi Source" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>

                            <TextBox Grid.Row="1" x:Name="TxtVCenterHost" Text="vcenter.lab.local" Tag="vCenter IP or FQDN" Style="{StaticResource EnterpriseInputTextBox}" Margin="0,0,0,8"/>

                            <Grid Grid.Row="2" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtVCenterUser" Text="administrator@vsphere.local" Tag="vCenter Username" Style="{StaticResource EnterpriseInputTextBox}"/>
                                <PasswordBox Grid.Column="2" x:Name="TxtVCenterPass" Tag="Password" Style="{StaticResource EnterpriseInputPasswordBox}" PasswordChanged="PasswordBox_PasswordChanged"/>
                            </Grid>

                            <CheckBox Grid.Row="3" x:Name="ChkIgnoreSsl" Content="Bypass Self-Signed SSL Certificate Warnings" Foreground="{StaticResource BrushTextSecondary}" IsChecked="True" FontSize="11" Margin="0,0,0,12"/>

                            <Button Grid.Row="4" x:Name="BtnConnectVCenter" Content="Connect &amp; Discover vCenter VMs" Style="{StaticResource CyanActionBtn}" Click="BtnConnectVCenter_Click" Margin="0,0,0,14"/>

                            <!-- vCenter Workloads List -->
                            <Grid Grid.Row="5">
                                <Border x:Name="VCenterEmptyState" Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource GeoServerContainer}" Fill="{StaticResource BrushTextMuted}" Stretch="Uniform" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="TxtVCenterStatus" Text="Enter credentials and connect to discover VMware VMs" Foreground="{StaticResource BrushTextMuted}" FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <ListBox x:Name="VCenterVmListBox" Visibility="Collapsed" Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" SelectionChanged="VCenterVmListBox_SelectionChanged" Foreground="{StaticResource BrushTextWhite}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0D1D30" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,4" Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="0" Data="{StaticResource GeoServerStack}" Fill="{StaticResource BrushCyanAccentHover}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,2,0,0">
                                                            <Run Text="vCPUs: "/><Run Text="{Binding CpuCount, Mode=OneWay}" FontWeight="SemiBold"/>
                                                            <Run Text=" | RAM: "/><Run Text="{Binding FormattedRam, Mode=OneWay}" FontWeight="SemiBold"/>
                                                            <Run Text=" | Disks: "/><Run Text="{Binding DiskCount, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <!-- Firmware Badge (EFI vs BIOS) -->
                                                    <Border Grid.Column="2" Background="#0E2338" BorderBrush="{StaticResource BrushCyanAccentHover}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Firmware, Mode=OneWay}" Foreground="{StaticResource BrushCyanAccentHover}" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                    <!-- Power Badge -->
                                                    <Border Grid.Column="4" Background="#0A1626" BorderThickness="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="#EF4444"/>
                                                                <Setter Property="Background" Value="#260A0A"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PowerState}" Value="PoweredOn">
                                                                        <Setter Property="BorderBrush" Value="#10B981"/>
                                                                        <Setter Property="Background" Value="#06281E"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PowerState}" Value="Suspended">
                                                                        <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                                        <Setter Property="Background" Value="#261E0A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding PowerState, Mode=OneWay}" FontSize="10" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PowerState}" Value="PoweredOn">
                                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding PowerState}" Value="Suspended">
                                                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- RIGHT CARD: TARGET HYPER-V & WORKLOAD EXPLORER -->
                    <Border Grid.Column="2" Background="{StaticResource BrushCardGradient}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Target Hyper-V Staging &amp; Workload Explorer" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>

                            <!-- Target Host IP -->
                            <TextBox Grid.Row="1" x:Name="TxtV2VTargetHost" Text="192.168.25.29" Tag="Target Hyper-V Host (IP or FQDN)" Style="{StaticResource EnterpriseInputTextBox}" Margin="0,0,0,6"/>

                            <!-- Target Credentials -->
                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtV2VTargetUser" Tag="Domain\User (Optional)" Style="{StaticResource EnterpriseInputTextBox}"/>
                                <PasswordBox Grid.Column="2" x:Name="TxtV2VTargetPass" Tag="Password (Optional)" Style="{StaticResource EnterpriseInputPasswordBox}" PasswordChanged="PasswordBox_PasswordChanged"/>
                            </Grid>

                            <!-- Connect Target Button & Network Status Badge -->
                            <Grid Grid.Row="3" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnConnectV2VTarget" Content="Connect &amp; Discover Node Capacity" Style="{StaticResource CyanActionBtn}" Click="BtnConnectV2VTarget_Click"/>
                                <Border Grid.Column="1" x:Name="V2VTargetNetworkBadge" Visibility="Collapsed" Background="#0C1B2A" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="8,0,0,0">
                                    <TextBlock x:Name="TxtV2VTargetNetworkStatus" Foreground="{StaticResource BrushSuccess}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Storage Backplane Volume Picker & Virtual Switch -->
                            <Grid Grid.Row="4" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="DESTINATION STORAGE POOL / CSV" Foreground="{StaticResource BrushTextSecondary}" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CmbV2VStorageVolumes" Style="{StaticResource HighContrastStorageComboBox}" SelectionChanged="CmbV2VStorageVolumes_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="2">
                                                    <Border Background="#0D253A" BorderBrush="{StaticResource BrushCyanAccent}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding StorageTypeBadge}" Foreground="{StaticResource BrushCyanAccentHover}" FontSize="9.5" FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Foreground="{StaticResource BrushSuccess}" FontWeight="SemiBold" FontSize="10.5" VerticalAlignment="Center">
                                                        <Run Text="(" /><Run Text="{Binding FreeSpaceGB, StringFormat='{}{0:F1}'}" /><Run Text=" GB Free)" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TARGET VIRTUAL SWITCH" Foreground="{StaticResource BrushTextSecondary}" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CmbV2VSwitches" Style="{StaticResource HighContrastStorageComboBox}"/>
                                </StackPanel>
                            </Grid>

                            <!-- LIVE WORKLOAD & CAPACITY EXPLORER PANEL -->
                            <Grid Grid.Row="5" Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header Banner -->
                                <Border Grid.Row="0" Background="#0A1524" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeoServerContainer}" Fill="{StaticResource BrushCyanAccentHover}" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0"/>
                                            <TextBlock Text="TARGET NODE WORKLOADS &amp; COLLISION AUDIT" Foreground="{StaticResource BrushTextWhite}" FontSize="10.5" FontWeight="Bold"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" x:Name="TxtTargetVmCount" Text="0 Workloads Detected" Foreground="{StaticResource BrushCyanAccentHover}" FontSize="10" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>

                                <!-- Target Workloads List -->
                                <Border Grid.Row="1" Background="#060C14" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="0,0,8,8">
                                    <Grid>
                                        <Border x:Name="TargetV2VEmptyState" Background="#08111D">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="Connect to Target Hyper-V to audit existing workloads" Foreground="{StaticResource BrushTextMuted}" FontSize="11" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <ListBox x:Name="TargetHyperVVmListBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextWhite}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,2">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Row 0: VM Name, Collision Alert Badge, State -->
                                                            <Grid Grid.Row="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                                <!-- Collision Warning Badge -->
                                                                <Border Grid.Column="1" Visibility="{Binding IsNameCollision, Converter={StaticResource BoolToVis}}" Background="#3B0B0B" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                                                    <TextBlock Text="⚠️ NAME COLLISION" Foreground="#EF4444" FontSize="9" FontWeight="Bold"/>
                                                                </Border>

                                                                <!-- Generation Badge -->
                                                                <Border Grid.Column="2" Background="#0E2338" BorderBrush="{StaticResource BrushCyanAccentHover}" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                                                    <TextBlock Text="{Binding GenerationLabel}" Foreground="{StaticResource BrushCyanAccentHover}" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                            </Grid>

                                                            <!-- Row 1: Specs & Disks -->
                                                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                                                <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="10.5">
                                                                    <Run Text="vCPUs: "/><Run Text="{Binding CpuCores}" FontWeight="SemiBold"/>
                                                                    <Run Text=" | RAM: "/><Run Text="{Binding FormattedRam}" FontWeight="SemiBold"/>
                                                                    <Run Text=" | "/><Run Text="{Binding DiskSummary}" Foreground="{StaticResource BrushTextMuted}"/>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <!-- CONVERSION ARCHITECTURE & STORAGE TIERING CARD -->
                                <Border Grid.Row="2" Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="CONVERSION ARCHITECTURE" Foreground="{StaticResource BrushCyanAccentHover}" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                                            <TextBlock x:Name="TxtV2VSelectedVmInfo" Text="Select a VMware VM on the left to review conversion specs." Foreground="{StaticResource BrushTextWhite}" FontSize="11" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="TxtV2VFirmwareParity" Text="Target Generation: Auto-detected from firmware" Foreground="{StaticResource BrushSuccess}" FontSize="10.5" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="TxtV2VEngineStatus" Text="Engine: Standalone qemu-img.exe Ready" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Multi-Disk Storage Tiering Matrix Opener Button -->
                                        <Button Grid.Column="1" x:Name="BtnOpenV2VTieringModal" Content="💽 Storage Tiering" Style="{StaticResource SlateOutlineBtn}" Click="BtnOpenV2VTieringModal_Click" VerticalAlignment="Center" Padding="10,6" ToolTip="Route Boot VHDX to NVMe SSD and Data VHDXs to High-Capacity HDD tiers"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Progress & Execute Bar -->
                            <StackPanel Grid.Row="6">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock x:Name="TxtV2VStepText" Text="Idle" Foreground="{StaticResource BrushTextSecondary}" FontSize="10.5"/>
                                    <TextBlock x:Name="TxtV2VPercentText" Text="0%" Foreground="{StaticResource BrushCyanAccentHover}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="PbV2VProgress" Height="7" Margin="0,0,0,8" Value="0"/>
                                <Button x:Name="BtnExecuteV2V" Content="▶ Convert &amp; Migrate to Hyper-V" Style="{StaticResource CyanActionBtn}" Click="BtnExecuteV2V_Click" Height="38" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========================================================= -->
            <!-- ROOT OVERLAY MODALS (ACCESSIBLE FROM ALL VIEWS)           -->
            <!-- ========================================================= -->

            <!-- MODAL: PRE-FLIGHT VALIDATION -->
            <Border x:Name="PreFlightModal" Visibility="Collapsed" Grid.RowSpan="3" Background="#E504080F" CornerRadius="12" Padding="30">
                <Border Background="{StaticResource BrushCardGradient}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="1" CornerRadius="12" Width="680" VerticalAlignment="Center" Padding="24" Effect="{StaticResource EffectModalShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Path Data="{StaticResource GeoPulse}" Fill="{StaticResource BrushCyanAccentHover}" Stretch="Uniform" Width="20" Height="20" Margin="0,0,10,0"/>
                            <TextBlock Text="Automated Pre-Flight System Validation" Foreground="{StaticResource BrushTextWhite}" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>

                        <ListBox x:Name="PreFlightCheckList" Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" MaxHeight="280" Margin="0,0,0,20">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding IsPassed}" Foreground="{StaticResource BrushSuccess}" FontWeight="Bold" FontSize="14" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding CheckName}" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Text="{Binding Details}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Style="{StaticResource SlateOutlineBtn}" Click="BtnClosePreFlight_Click" Margin="0,0,10,0"/>
                            <Button x:Name="BtnProceedMigration" Content="Proceed with Live Migration" Style="{StaticResource CyanActionBtn}" Click="BtnProceedMigration_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- MODAL: INFRASTRUCTURE DOCTOR -->
            <Border x:Name="InfraDoctorModal" Visibility="Collapsed" Grid.RowSpan="3" Background="#E504080F" CornerRadius="12" Padding="30">
                <Border Background="{StaticResource BrushCardGradient}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="1" CornerRadius="12" Width="780" VerticalAlignment="Center" Padding="24" Effect="{StaticResource EffectModalShadow}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoPulse}" Fill="{StaticResource BrushCyanAccentHover}" Stretch="Uniform" Width="20" Height="20" Margin="0,0,10,0"/>
                                <TextBlock Text="Infrastructure Doctor: Kerberos &amp; WinRM Self-Healing" Foreground="{StaticResource BrushTextWhite}" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <Button Content="✕" Style="{StaticResource PowerOpBtn}" Click="BtnCloseDoctorModal_Click" HorizontalAlignment="Right" Width="26" Height="26"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="SOURCE NODE AUDIT" Foreground="{StaticResource BrushCyanAccentHover}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtDocSourceHost" Text="Source: Checking..." Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="13" Margin="0,4,0,8"/>
                                    <TextBlock x:Name="TxtDocSourceMig" Text="Live Migration: Unknown" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="TxtDocSourceAuth" Text="Auth Protocol: Unknown" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="TARGET NODE AUDIT" Foreground="{StaticResource BrushSuccess}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtDocTargetHost" Text="Target: Checking..." Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="13" Margin="0,4,0,8"/>
                                    <TextBlock x:Name="TxtDocTargetMig" Text="Live Migration: Unknown" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="TxtDocTargetAuth" Text="Auth Protocol: Unknown" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TxtDocTargetFolder" Text="Storage Directory: Checking..." Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="#05080E" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,18">
                            <TextBox x:Name="TxtDoctorLogs" Background="Transparent" Foreground="{StaticResource BrushCyanAccentHover}" FontFamily="Consolas" FontSize="11" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" Text="Audit ready. If any host protocol shows CredSSP or Disabled, click 'Auto-Repair Both Hosts' below."/>
                        </Border>

                        <Grid>
                            <Button Content="Re-Run Audit" Style="{StaticResource SlateOutlineBtn}" Click="BtnReRunAudit_Click" HorizontalAlignment="Left" Width="140"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Close" Style="{StaticResource SlateOutlineBtn}" Click="BtnCloseDoctorModal_Click" Margin="0,0,10,0"/>
                                <Button x:Name="BtnAutoRepairHosts" Content="⚡ 1-Click Auto-Repair Both Hosts" Style="{StaticResource CyanActionBtn}" Click="BtnAutoRepairHosts_Click" Width="260"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- MODAL: CPU ARCHITECTURE AUDIT & COMPATIBILITY FIX -->
            <Border x:Name="CpuCompatibilityModal" Visibility="Collapsed" Grid.RowSpan="3" Background="#E504080F" CornerRadius="12" Padding="30">
                <Border Background="{StaticResource BrushCardGradient}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="1" CornerRadius="12" Width="680" VerticalAlignment="Center" Padding="24" Effect="{StaticResource EffectModalShadow}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="18" Foreground="{StaticResource BrushCyanAccentHover}" Margin="0,0,8,0"/>
                                <TextBlock Text="Processor Compatibility Auditor (0x80072740 Guard)" Foreground="{StaticResource BrushTextWhite}" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <Button Content="✕" Style="{StaticResource PowerOpBtn}" Click="BtnCloseCpuModal_Click" HorizontalAlignment="Right" Width="26" Height="26"/>
                        </Grid>

                        <Border Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" x:Name="TxtCpuSourceDetails" Text="Source Host CPU: Ingesting..." Foreground="{StaticResource BrushTextWhite}" FontSize="13"/>
                                <TextBlock Grid.Row="1" x:Name="TxtCpuTargetDetails" Text="Target Host CPU: Ingesting..." Foreground="{StaticResource BrushTextWhite}" FontSize="13" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="2" x:Name="TxtCpuAuditRecommendation" Text="Audit Status: Ready" Foreground="{StaticResource BrushCyanAccentHover}" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Processor Compatibility Mode masks differing CPU features to permit seamless live migrations across disparate Intel or AMD generations without cold restarts." Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <Grid>
                            <Button Content="Close" Style="{StaticResource SlateOutlineBtn}" Click="BtnCloseCpuModal_Click" HorizontalAlignment="Left" Width="120"/>
                            <Button x:Name="BtnFixCpuCompatibility" Content="⚡ 1-Click Enable Processor Compatibility" Style="{StaticResource CyanActionBtn}" Click="BtnFixCpuCompatibility_Click" HorizontalAlignment="Right" Width="280"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- MODAL: MULTI-vNIC REMAPPING MATRIX -->
            <Border x:Name="MultiNicRemapModal" Visibility="Collapsed" Grid.RowSpan="3" Background="#E504080F" CornerRadius="12" Padding="30">
                <Border Background="{StaticResource BrushCardGradient}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="1" CornerRadius="12" Width="760" VerticalAlignment="Center" Padding="24" Effect="{StaticResource EffectModalShadow}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔀" FontSize="18" Foreground="{StaticResource BrushCyanAccentHover}" Margin="0,0,8,0"/>
                                <TextBlock Text="Multi-vNIC Virtual Switch &amp; VLAN Remapping Matrix" Foreground="{StaticResource BrushTextWhite}" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <Button Content="✕" Style="{StaticResource PowerOpBtn}" Click="BtnCloseNicModal_Click" HorizontalAlignment="Right" Width="26" Height="26"/>
                        </Grid>

                        <TextBlock Text="Workload network adapters must connect to valid virtual switches on the target host." Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,14"/>

                        <ListBox x:Name="NicMappingListBox" Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" MaxHeight="300" Margin="0,0,0,20">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding AdapterName}" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="{Binding MacAddress}" Foreground="{StaticResource BrushTextMuted}" FontSize="10"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="SOURCE SWITCH" Foreground="{StaticResource BrushTextSecondary}" FontSize="9" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SourceSwitchName}" Foreground="{StaticResource BrushCyanAccentHover}" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="➔" Foreground="{StaticResource BrushTextMuted}" FontSize="14" VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="TARGET SWITCH MAPPING" Foreground="{StaticResource BrushSuccess}" FontSize="9" FontWeight="Bold"/>
                                                <TextBox Text="{Binding TargetSwitchName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EnterpriseInputTextBox}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid>
                            <Button Content="Cancel" Style="{StaticResource SlateOutlineBtn}" Click="BtnCloseNicModal_Click" HorizontalAlignment="Left" Width="120"/>
                            <Button Content="Save Adapter Mappings" Style="{StaticResource CyanActionBtn}" Click="BtnApplyNicMappings_Click" HorizontalAlignment="Right" Width="180"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- MODAL: DISAGGREGATED MULTI-VHDX STORAGE MATRIX -->
            <Border x:Name="DisaggregatedStorageModal" Visibility="Collapsed" Grid.RowSpan="3" Background="#E504080F" CornerRadius="12" Padding="30">
                <Border Background="{StaticResource BrushCardGradient}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="1" CornerRadius="12" Width="820" VerticalAlignment="Center" Padding="24" Effect="{StaticResource EffectModalShadow}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="18" Foreground="{StaticResource BrushCyanAccentHover}" Margin="0,0,8,0"/>
                                <TextBlock Text="Multi-VHDX Storage Disaggregation Matrix" Foreground="{StaticResource BrushTextWhite}" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <Button Content="✕" Style="{StaticResource PowerOpBtn}" Click="BtnCloseDisaggregatedModal_Click" HorizontalAlignment="Right" Width="26" Height="26"/>
                        </Grid>

                        <TextBlock Text="Route distinct virtual hard disks to specific destination volumes (e.g., CSV Volume 1 for OS, Volume 2 for Data)." Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,14"/>

                        <ListBox x:Name="DisaggregatedDisksListBox" Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" MaxHeight="300" Margin="0,0,0,20">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ControllerType}" Foreground="{StaticResource BrushTextMuted}" FontSize="10"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding SizeFormatted}" Foreground="{StaticResource BrushCyanAccentHover}" FontSize="12" VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="TARGET DIRECTORY PATH" Foreground="{StaticResource BrushSuccess}" FontSize="9" FontWeight="Bold"/>
                                                <TextBox Text="{Binding TargetDirectoryPath, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. C:\ClusterStorage\Volume2\VMs" Style="{StaticResource EnterpriseInputTextBox}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid>
                            <Button Content="Cancel" Style="{StaticResource SlateOutlineBtn}" Click="BtnCloseDisaggregatedModal_Click" HorizontalAlignment="Left" Width="120"/>
                            <Button Content="Save Storage Routing" Style="{StaticResource CyanActionBtn}" Click="BtnApplyDisaggregatedPaths_Click" HorizontalAlignment="Right" Width="180"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- MODAL: MAINTENANCE WINDOW SCHEDULER -->
            <Border x:Name="SchedulerModal" Visibility="Collapsed" Grid.RowSpan="3" Background="#E504080F" CornerRadius="12" Padding="30">
                <Border Background="{StaticResource BrushCardGradient}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="1" CornerRadius="12" Width="640" VerticalAlignment="Center" Padding="24" Effect="{StaticResource EffectModalShadow}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱" FontSize="18" Foreground="{StaticResource BrushSuccess}" Margin="0,0,8,0"/>
                                <TextBlock Text="Maintenance Window &amp; Batch Scheduler" Foreground="{StaticResource BrushTextWhite}" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <Button Content="✕" Style="{StaticResource PowerOpBtn}" Click="BtnCloseSchedulerModal_Click" HorizontalAlignment="Right" Width="26" Height="26"/>
                        </Grid>

                        <!-- Batch Name -->
                        <TextBlock Text="BATCH NAME" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtScheduleBatchName" Text="Datacenter Evacuation Window" Style="{StaticResource EnterpriseInputTextBox}" Margin="0,0,0,14"/>

                        <!-- Execution Time Picker -->
                        <TextBlock Text="SCHEDULED TIME (UTC / LOCAL)" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DpScheduleDate" Margin="0,0,0,8" Background="#08111D" Foreground="{StaticResource BrushTextWhite}"/>
                        <TextBox x:Name="TxtScheduleTime" Text="02:00" Tag="HH:mm (24hr)" Style="{StaticResource EnterpriseInputTextBox}" Margin="0,0,0,14"/>

                        <!-- Concurrency Throttling -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CONCURRENCY LIMIT (SEMAPHORE)" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="Max parallel live migrations to prevent NIC/IOPS saturation." Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="TxtScheduleConcurrency" Text="2" Style="{StaticResource EnterpriseInputTextBox}" HorizontalContentAlignment="Center"/>
                        </Grid>

                        <!-- Post-Flight Auto-Rollback -->
                        <Border Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,20">
                            <CheckBox x:Name="ChkAutoRollback" IsChecked="True">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Auto-Rollback on Guest Heartbeat Failure" Foreground="{StaticResource BrushTextWhite}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="Automatically migrates workload back to source if guest OS fails to report healthy heartbeat within 180s." Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <Grid>
                            <Button Content="Cancel" Style="{StaticResource SlateOutlineBtn}" Click="BtnCloseSchedulerModal_Click" HorizontalAlignment="Left" Width="120"/>
                            <Button Content="Enqueue Scheduled Batch" Style="{StaticResource CyanActionBtn}" Click="BtnConfirmScheduleBatch_Click" HorizontalAlignment="Right" Width="200"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- MODAL: ENTERPRISE VM HARDWARE TUNER -->
            <Border x:Name="VmHardwareTunerModal" Visibility="Collapsed" Background="#E504080F" CornerRadius="12" Padding="30">
                <Border Background="{StaticResource BrushCardGradient}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="1" CornerRadius="12" Width="660" VerticalAlignment="Center" Padding="24" Effect="{StaticResource EffectModalShadow}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoSettings}" Fill="{StaticResource BrushCyanAccentHover}" Stretch="Uniform" Width="20" Height="20" Margin="0,0,10,0"/>
                                <TextBlock Text="Hardware Specification &amp; Virtual Tuning" Foreground="{StaticResource BrushTextWhite}" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <Button Content="✕" Style="{StaticResource PowerOpBtn}" Click="BtnCloseTunerModal_Click" HorizontalAlignment="Right" Width="26" Height="26"/>
                        </Grid>

                        <Border Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="TxtTunerVmName" Text="Workload: VM Name" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock x:Name="TxtTunerHostName" Text="Resident Host: DC2.lab.local" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#0D253A" BorderBrush="{StaticResource BrushCyanAccent}" BorderThickness="1" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtTunerState" Text="OFFLINE" Foreground="{StaticResource BrushCyanAccentHover}" FontWeight="Bold" FontSize="11"/>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="PROCESSOR ALLOCATION (vCPUs)" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtTunerCpu" Text="4" Style="{StaticResource EnterpriseInputTextBox}"/>
                            <CheckBox Grid.Column="2" x:Name="ChkCpuCompatibilityMode" Content="Processor Compatibility Mode (0x80072740 Fix)" Foreground="{StaticResource BrushTextWhite}" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="MEMORY ALLOCATION (RAM IN MB)" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtTunerRamMb" Text="2048" Style="{StaticResource EnterpriseInputTextBox}"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="+1 GB" Style="{StaticResource PowerOpBtn}" Click="BtnAdd1Gb_Click" Margin="0,0,6,0"/>
                                <Button Content="+2 GB" Style="{StaticResource PowerOpBtn}" Click="BtnAdd2Gb_Click" Margin="0,0,6,0"/>
                                <Button Content="+4 GB" Style="{StaticResource PowerOpBtn}" Click="BtnAdd4Gb_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#070E18" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="ChkDynamicMemory" Content="Enable Dynamic Memory" Foreground="{StaticResource BrushCyanAccentHover}" FontWeight="Bold" Checked="ChkDynamicMemory_Checked" Unchecked="ChkDynamicMemory_Unchecked"/>
                                <Grid x:Name="PanelDynamicMemoryBounds" Visibility="Collapsed" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="MIN RAM (MB)" Foreground="{StaticResource BrushTextSecondary}" FontSize="9"/>
                                        <TextBox x:Name="TxtTunerMinRamMb" Text="512" Style="{StaticResource EnterpriseInputTextBox}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="MAX RAM (MB)" Foreground="{StaticResource BrushTextSecondary}" FontSize="9"/>
                                        <TextBox x:Name="TxtTunerMaxRamMb" Text="16384" Style="{StaticResource EnterpriseInputTextBox}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="NETWORK VIRTUAL SWITCH" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbTunerSwitches" Style="{StaticResource HighContrastStorageComboBox}" Margin="0,0,0,20"/>

                        <Grid>
                            <Button Content="Cancel" Style="{StaticResource SlateOutlineBtn}" Click="BtnCloseTunerModal_Click" HorizontalAlignment="Left" Width="120"/>
                            <Button x:Name="BtnApplyVmSpecs" Content="Apply Hardware Specs" Style="{StaticResource CyanActionBtn}" Click="BtnApplyVmSpecs_Click" HorizontalAlignment="Right" Width="180"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- MODAL: CHECKPOINT & AVHDX CHAIN MANAGER -->
            <Border x:Name="CheckpointManagerModal" Visibility="Collapsed" Background="#E504080F" CornerRadius="12" Padding="30">
                <Border Background="{StaticResource BrushCardGradient}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="1" CornerRadius="12" Width="720" VerticalAlignment="Center" Padding="24" Effect="{StaticResource EffectModalShadow}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📸" FontSize="18" Foreground="{StaticResource BrushCyanAccentHover}" Margin="0,0,8,0"/>
                                <TextBlock Text="Checkpoint &amp; AVHDX Chain Manager" Foreground="{StaticResource BrushTextWhite}" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <Button Content="✕" Style="{StaticResource PowerOpBtn}" Click="BtnCloseCheckpointModal_Click" HorizontalAlignment="Right" Width="26" Height="26"/>
                        </Grid>

                        <Border Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="TxtCheckpointVmName" Text="Workload: VM Name" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="13.5"/>
                                    <TextBlock x:Name="TxtCheckpointHostName" Text="Resident Node: Host" Foreground="{StaticResource BrushTextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="TxtCheckpointChainSummary" Text="0 Checkpoints (0 GB Delta)" Foreground="{StaticResource BrushCyanAccentHover}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ListBox x:Name="CheckpointsListBox" Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" MaxHeight="260" Margin="0,0,0,18" Foreground="{StaticResource BrushTextWhite}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding CheckpointName}" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Text="{Binding CreationTime, StringFormat='{}Created: {0:yyyy-MM-dd HH:mm}'}" Foreground="{StaticResource BrushTextMuted}" FontSize="10.5"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding FormattedDeltaSize}" Foreground="{StaticResource BrushWarning}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Content="🗑 Merge/Delete" Style="{StaticResource PowerOpBtn}" Tag="{Binding}" Click="BtnDeleteCheckpoint_Click" VerticalAlignment="Center" Padding="8,3"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid>
                            <Button Content="Close" Style="{StaticResource SlateOutlineBtn}" Click="BtnCloseCheckpointModal_Click" HorizontalAlignment="Left" Width="120"/>
                            <Button x:Name="BtnCreateNewSnapshot" Content="+ Create Point-in-Time Checkpoint" Style="{StaticResource CyanActionBtn}" Click="BtnCreateNewSnapshot_Click" HorizontalAlignment="Right" Width="250"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- MODAL: V2V MULTI-DISK NVMe SSD vs HDD STORAGE TIERING MATRIX -->
            <Border x:Name="V2VMultiDiskTieringModal" Visibility="Collapsed" Background="#E504080F" CornerRadius="12" Padding="30">
                <Border Background="{StaticResource BrushCardGradient}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="1" CornerRadius="12" Width="820" VerticalAlignment="Center" Padding="24" Effect="{StaticResource EffectModalShadow}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💽" FontSize="18" Foreground="{StaticResource BrushCyanAccentHover}" Margin="0,0,8,0"/>
                                <TextBlock Text="V2V Multi-Disk Storage Tiering Matrix (NVMe SSD vs. HDD)" Foreground="{StaticResource BrushTextWhite}" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <Button Content="✕" Style="{StaticResource PowerOpBtn}" Click="BtnCloseV2VTieringModal_Click" HorizontalAlignment="Right" Width="26" Height="26"/>
                        </Grid>

                        <TextBlock Text="Route virtual hard disks to specific destination storage pools (e.g. Boot/OS VHDX to high-speed NVMe CSV, Data VHDXs to HDD Tier)." Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,14"/>

                        <ListBox x:Name="V2VDisksListBox" Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" MaxHeight="320" Margin="0,0,0,20" Foreground="{StaticResource BrushTextWhite}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="12.5"/>
                                                <TextBlock Foreground="{StaticResource BrushCyanAccentHover}" FontSize="10" Margin="0,2,0,0">
                                                    <Run Text="{Binding ControllerType}"/><Run Text=" "/><Run Text="{Binding ControllerNumber}"/><Run Text=":"/><Run Text="{Binding ControllerLocation}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" Foreground="{StaticResource BrushSuccess}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="DESTINATION STORAGE DIRECTORY" Foreground="{StaticResource BrushSuccess}" FontSize="9" FontWeight="Bold"/>
                                                <TextBox Text="{Binding TargetStoragePath, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. C:\ClusterStorage\Volume1_NVMe" Style="{StaticResource EnterpriseInputTextBox}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid>
                            <Button Content="Cancel" Style="{StaticResource SlateOutlineBtn}" Click="BtnCloseV2VTieringModal_Click" HorizontalAlignment="Left" Width="120"/>
                            <Button Content="Save Storage Routing" Style="{StaticResource CyanActionBtn}" Click="BtnApplyV2VTiering_Click" HorizontalAlignment="Right" Width="180"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

        </Grid>
    </Grid>
</Window>