                                <Path Data="{StaticResource GeoSettings}" Fill="{StaticResource BrushCyanAccentHover}" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Infra Doctor"/>
