<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinMigrate PRO (ElectroMU Edition) - By Oleg Melnikov" 
        Icon="database-management.ico"
        Height="940" Width="1540"
        MinHeight="780" MinWidth="1240"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackgroundDark}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PowerOpBtn" TargetType="Button">
            <Setter Property="Background" Value="#0E1E30"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BrushCyanAccentHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}"/>
                                <Setter TargetName="b" Property="Effect" Value="{StaticResource EffectButtonGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Enterprise Dark Cyber ComboBox Style -->
        <Style x:Key="HighContrastStorageComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#0A131F"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushCyanAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="#0A131F"
                                          BorderBrush="{StaticResource BrushCyanAccent}"
                                          BorderThickness="1"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource BrushCyanAccentHover}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BrushCyanAccentHover}"/>
                                                <Setter TargetName="b" Property="Background" Value="#102033"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,32,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#0C1726" BorderBrush="{StaticResource BrushCyanAccent}" BorderThickness="1" CornerRadius="6" Margin="0,3,0,0">
                                        <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#0E1B2C"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#17283C"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BrushCyanAccent}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#0A3355"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- SIDEBAR COLUMN -->
            <ColumnDefinition Width="260"/>
            <!-- MAIN CONTENT COLUMN -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- LEFT SIDEBAR                                              -->
        <!-- ========================================================= -->
        <Border Grid.Column="0" Background="{StaticResource BrushSidebarDark}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- BRAND LOGO -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,32">
                    <Border Background="{StaticResource BrushCyanBtnGradient}" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0" Effect="{StaticResource EffectCyanGlow}">
                        <Path Data="{StaticResource GeoServerStack}" Fill="{StaticResource BrushTextWhite}" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WinMigrate" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="17"/>
                        <TextBlock Text="ELECTROMU EDITION" Foreground="{StaticResource BrushCyanAccentHover}" FontSize="9.5" FontWeight="Bold" Margin="0,-1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- NAVIGATION BUTTONS -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavOrchestrator" Style="{StaticResource SidebarNavRadioBtn}" IsChecked="True" GroupName="SidebarNav">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoOrchestrator}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Migration Orchestrator" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavInventory" Style="{StaticResource SidebarNavRadioBtn}" GroupName="SidebarNav">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoInventory}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Global Inventory" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavJobs" Style="{StaticResource SidebarNavRadioBtn}" GroupName="SidebarNav">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoPulse}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Active Jobs" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavVCenter" Style="{StaticResource SidebarNavRadioBtn}" GroupName="SidebarNav">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoServerContainer}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,12,0"/>
                            <TextBlock Text="vCenter V2V Importer" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource SidebarNavRadioBtn}" GroupName="SidebarNav">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoSettings}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- AUTHOR & ARCHITECTURE FOOTER BADGE -->
                <Border Grid.Row="2" Background="{StaticResource BrushCardGradient}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Oleg Melnikov" Foreground="{StaticResource BrushCyanAccentHover}" FontSize="12.5" FontWeight="Bold"/>
                        <TextBlock Text="ElectroMU Gaming Network" Foreground="{StaticResource BrushSuccess}" FontSize="10.5" FontWeight="SemiBold" Margin="0,2,0,4"/>
                        <TextBlock Text="Agentless WinRM &#x2022; .NET 10" Foreground="{StaticResource BrushTextMuted}" FontSize="10"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- MAIN CONTENT VIEWPORTS & ROOT OVERLAYS                    -->
        <!-- ========================================================= -->
        <Grid Grid.Column="1" Margin="32,24,32,24">

            <!-- ===================================================== -->
            <!-- 1. MIGRATION ORCHESTRATOR VIEW                        -->
            <!-- ===================================================== -->
            <Grid Visibility="{Binding ElementName=NavOrchestrator, Path=IsChecked, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoServerContainer}" Fill="{StaticResource BrushCyanAccentHover}" Stretch="Uniform" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Migration Orchestrator" Foreground="{StaticResource BrushTextWhite}" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Text="Enterprise Live Migration with Multi-vNIC mapping, storage disaggregation, CPU compatibility, and queue throttling." Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="34,4,0,0"/>
                </StackPanel>

                <!-- Host Cards Grid -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- SOURCE CARD -->
                    <Border Grid.Column="0" Background="{StaticResource BrushCardGradient}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Source Datacenter / Host" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>

                            <TextBox Grid.Row="1" x:Name="TxtSourceHost" Text="192.168.25.29" Tag="IP or Hostname" Style="{StaticResource EnterpriseInputTextBox}" Margin="0,0,0,6"/>

                            <!-- Network Diagnostic Badge -->
                            <Border Grid.Row="2" x:Name="SourceNetworkBadge" Visibility="Collapsed" Background="#0C1B2A" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,0,10">
                                <TextBlock x:Name="TxtSourceNetworkStatus" Foreground="{StaticResource BrushSuccess}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>

                            <!-- User & Password Row -->
                            <Grid Grid.Row="3" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" x:Name="TxtSourceUser" Tag="Domain\User (Optional)" Style="{StaticResource EnterpriseInputTextBox}"/>
                                <PasswordBox Grid.Column="2" x:Name="TxtSourcePass" Tag="Password (Optional)" Style="{StaticResource EnterpriseInputPasswordBox}" PasswordChanged="PasswordBox_PasswordChanged"/>
                            </Grid>

                            <Button Grid.Row="4" x:Name="BtnConnectSource" Content="Connect &amp; Discover VMs" Style="{StaticResource CyanActionBtn}" Click="BtnConnectSource_Click" Margin="0,0,0,12"/>

                            <!-- Live Source Capacity Gauge Bar -->
                            <Border Grid.Row="5" x:Name="SourceTelemetryBar" Visibility="Collapsed" Background="#091422" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Grid>
                                            <TextBlock Text="CPU LOAD" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtSourceCpuGauge" Text="0%" Foreground="{StaticResource BrushCyanAccentHover}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar x:Name="PbSourceCpu" Height="6" Background="#08101A" BorderThickness="0" Margin="0,5,0,0" Value="0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid>
                                            <TextBlock Text="RAM UTILIZATION" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtSourceRamGauge" Text="0.0 GB" Foreground="{StaticResource BrushSuccess}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar x:Name="PbSourceRam" Height="6" Background="#08101A" BorderThickness="0" Margin="0,5,0,0" Value="0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="6">
                                <Border x:Name="SourceEmptyState" Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource GeoServerContainer}" Fill="{StaticResource BrushTextMuted}" Stretch="Uniform" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="TxtSourceStatus" Text="Connect to a Source Host to discover VMs" Foreground="{StaticResource BrushTextMuted}" FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Draggable Multi-Select VM List with Edit Specs Button -->
                                <ListBox x:Name="SourceVmList" SelectionMode="Extended" Visibility="Collapsed" Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" SelectionChanged="SourceVmList_SelectionChanged" PreviewMouseLeftButtonDown="SourceVmList_PreviewMouseLeftButtonDown" PreviewMouseMove="SourceVmList_PreviewMouseMove" Foreground="{StaticResource BrushTextWhite}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0D1D30" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,4" Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="0" Data="{StaticResource GeoServerStack}" Fill="{StaticResource BrushCyanAccentHover}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="10.5" Margin="0,2,0,0">
                                <Run Text="vCPUs: "/><Run Text="{Binding CpuCores, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text=" | RAM: "/><Run Text="{Binding FormattedRam, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text=" | "/><Run Text="{Binding GenerationLabel, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Edit Specs Button -->
                                                    <Button Grid.Column="2" Content="⚙ Edit Specs" Style="{StaticResource PowerOpBtn}" Tag="{Binding}" Click="BtnEditVmSpecs_Click" Padding="8,4"/>

                                                    <!-- Power Badge -->
                                                    <Border Grid.Column="4" Background="#0A1626" BorderBrush="{Binding PowerBadgeColor, Mode=OneWay}" BorderThickness="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PowerState, Mode=OneWay}" Foreground="{Binding PowerBadgeColor, Mode=OneWay}" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- TARGET CARD -->
                    <Border Grid.Column="2" x:Name="TargetCardBorder" Background="{StaticResource BrushCardGradient}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="1" CornerRadius="12" Padding="20" AllowDrop="True" DragEnter="TargetDropZone_DragEnter" DragLeave="TargetDropZone_DragLeave" Drop="TargetDropZone_Drop">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Target Datacenter / Host" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>

                            <TextBox Grid.Row="1" x:Name="TxtTargetHost" Tag="IP or Hostname (e.g., dc2.domain.local)" Style="{StaticResource EnterpriseInputTextBox}" Margin="0,0,0,6"/>

                            <!-- Network Diagnostic Badge -->
                            <Border Grid.Row="2" x:Name="TargetNetworkBadge" Visibility="Collapsed" Background="#0C1B2A" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,0,10">
                                <TextBlock x:Name="TxtTargetNetworkStatus" Foreground="{StaticResource BrushSuccess}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>

                            <Grid Grid.Row="3" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" x:Name="TxtTargetUser" Tag="Domain\User (Optional)" Style="{StaticResource EnterpriseInputTextBox}"/>
                                <PasswordBox Grid.Column="2" x:Name="TxtTargetPass" Tag="Password (Optional)" Style="{StaticResource EnterpriseInputPasswordBox}" PasswordChanged="PasswordBox_PasswordChanged"/>
                            </Grid>

                            <Button Grid.Row="4" x:Name="BtnConnectTarget" Content="Connect &amp; Verify Target" Style="{StaticResource CyanActionBtn}" Click="BtnConnectTarget_Click" Margin="0,0,0,14"/>

                            <!-- Capacity Panel / Empty State in Row 5 -->
                            <Grid Grid.Row="5">
                                <Border x:Name="TargetEmptyState" Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource GeoServerContainer}" Fill="{StaticResource BrushTextMuted}" Stretch="Uniform" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="TxtTargetStatus" Text="Connect to a Target Host to verify capacity (Drop VM here)" Foreground="{StaticResource BrushTextMuted}" FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="TargetCapacityPanel" Visibility="Collapsed" Background="#08111D" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtTargetNameHeader" Text="NODE READY" Foreground="{StaticResource BrushSuccess}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                                        <Grid Margin="10,0,10,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#0E1E32" CornerRadius="8" Padding="10" Margin="0,0,6,0" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="TOTAL CORES" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtTargetCores" Text="0" Foreground="{StaticResource BrushTextWhite}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="#0E1E32" CornerRadius="8" Padding="10" Margin="6,0,0,0" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="FREE RAM (GB)" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtTargetRam" Text="0.0" Foreground="{StaticResource BrushCyanAccentHover}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Target RAM Progress Bar -->
                                        <StackPanel Margin="10,0,10,14">
                                            <Grid>
                                                <TextBlock Text="TARGET RAM CAPACITY" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock x:Name="TxtTargetRamGaugePercent" Text="0%" Foreground="{StaticResource BrushCyanAccentHover}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <ProgressBar x:Name="PbTargetRam" Height="6" Background="#08101A" BorderThickness="0" Margin="0,5,0,0" Value="0"/>
                                        </StackPanel>

                                        <!-- HIGH-CONTRAST STORAGE PICKER -->
                                        <StackPanel Margin="10,0">
                                            <TextBlock Text="TARGET STORAGE VOLUME / CSV" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="CmbTargetStorageVolumes" Style="{StaticResource HighContrastStorageComboBox}" SelectionChanged="CmbTargetStorageVolumes_SelectionChanged">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="2">
                                                            <Border Background="#0D253A" BorderBrush="{StaticResource BrushCyanAccent}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding FileSystem}" Foreground="{StaticResource BrushCyanAccentHover}" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Path}" Foreground="{StaticResource BrushTextWhite}" FontWeight="Bold" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Foreground="{StaticResource BrushSuccess}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center">
                                                                <Run Text="(" /><Run Text="{Binding FreeSpaceGB, StringFormat='{}{0:F1}'}" /><Run Text=" GB Free)" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ENTERPRISE BOTTOM BATCH & COMMAND BAR -->
                <Border Grid.Row="2" Background="{StaticResource BrushCardGradient}" BorderBrush="{StaticResource BrushCardBorderGlow}" BorderThickness="1" CornerRadius="12" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="PAYLOAD SELECTION" Foreground="{StaticResource BrushCyanAccentHover}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtPayloadStatus" Text="None Selected" Foreground="{StaticResource BrushTextWhite}" FontSize="14.5" FontWeight="Bold" Margin="0,2,0,0"/>
