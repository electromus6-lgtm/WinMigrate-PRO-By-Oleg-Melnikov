                        </Button>

                        <Button Grid.Column="6" x:Name="BtnCpuAudit" Style="{StaticResource SlateOutlineBtn}" Click="BtnCpuAudit_Click" ToolTip="Audit cross-generation CPU instruction compatibility (Fix 0x80072740)">
